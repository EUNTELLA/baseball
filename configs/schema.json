{
  "schema_version": "competition-v1",
  "notice": "control_success는 공식 Target이며 입력 컬럼은 데이터 공개 후 확정합니다.",
  "id_columns": ["pitch_id", "game_id", "pitcher_id", "batter_id", "team_id"],
  "time_columns": ["season", "game_date", "pitch_sequence"],
  "numeric_features": [
    "balls", "strikes", "outs", "inning", "score_diff",
    "runner_1b", "runner_2b", "runner_3b",
    "win_expectancy", "leverage_index",
    "asof_success_rate", "recent_game_success_rate",
    "asof_fastball_rate", "asof_velocity", "asof_spin_rate",
    "asof_horizontal_movement", "asof_vertical_movement",
    "asof_release_height", "asof_release_side", "asof_extension"
  ],
  "categorical_features": ["pitch_type_history"],
  "target_column": "control_success",
  "train_seasons": [2019, 2020, 2021, 2022, 2023, 2024],
  "test_season": 2025
}
